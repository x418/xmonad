name:               xmonad
version:            0.18.1.9
synopsis:           A tiling window manager
description:        xmonad is a tiling window manager for X. Windows are arranged
                    automatically to tile the screen without gaps or overlap, maximising
                    screen use. All features of the window manager are accessible from the
                    keyboard: a mouse is strictly optional. xmonad is written and
                    extensible in Haskell. Custom layout algorithms, and other extensions,
                    may be written by the user in config files. Layouts are applied
                    dynamically, and different layouts may be used on each workspace.
                    Xinerama is fully supported, allowing windows to be tiled on several
                    screens.
license:            BSD3
license-file:       LICENSE
author:             Spencer Janssen, Don Stewart, Adam Vogt, David Roundy, Jason Creighton,
                    Brent Yorgey, Peter Jones, Peter Simons, Andrea Rossato, Devin Mullins,
                    Lukas Mai, Alec Berryman, Stefan O'Rear, Daniel Wagner, Peter J. Jones,
                    Daniel Schoepe, Karsten Schoelzel, Neil Mitchell, Joachim Breitner,
                    Peter De Wachter, Eric Mertens, Geoff Reedy, Michiel Derhaeg,
                    Philipp Balzarek, Valery V. Vorotyntsev, Alex Tarkovsky, Fabian Beuke,
                    Felix Hirn, Michael Sloan, Tomas Janousek, Vanessa McHale, Nicolas Pouillard,
                    Aaron Denney, Austin Seipp, Benno Fünfstück, Brandon S Allbery, Chris Mears,
                    Christian Thiemann, Clint Adams, Daniel Neri, David Lazar, Ferenc Wagner,
                    Francesco Ariis, Gábor Lipták, Ivan N. Veselov, Ivan Tarasov, Javran Cheng,
                    Jens Petersen, Joey Hess, Jonne Ransijn, Josh Holland, Khudyakov Alexey,
                    Klaus Weidner, Michael G. Sloan, Mikkel Christiansen, Nicolas Dudebout,
                    Ondřej Súkup, Paul Hebble, Shachaf Ben-Kiki, Siim Põder, Tim McIver,
                    Trevor Elliott, Wouter Swierstra, Conrad Irwin, Tim Thelion, Tony Zorman
maintainer:         xmonad@haskell.org
tested-with:        GHC == 8.6.5 || == 8.8.4 || == 8.10.7 || == 9.0.2 || == 9.2.8 || == 9.4.8 || == 9.6.7 || == 9.8.4 || == 9.10.3 || == 9.12.4 || == 9.14.1
category:           System
homepage:           http://xmonad.org
bug-reports:        https://github.com/xmonad/xmonad/issues
build-type:         Simple
extra-source-files: README.md
                    CHANGES.md
                    CONTRIBUTING.md
                    INSTALL.md
                    MAINTAINERS.md
                    TUTORIAL.md
                    man/xmonad.1.markdown
                    man/xmonad.1
                    man/xmonad.1.html
                    man/xmonad.hs
                    util/hpcReport.sh
cabal-version:      1.12

source-repository head
  type:     git
  location: https://github.com/xmonad/xmonad

flag pedantic
  description: Be pedantic (-Werror and the like)
  default:     False
  manual:      True

flag river
  description: Build against river/Wayland instead of X11.
  default:     False
  manual:      True
  -- 'manual' matters: without it the solver is free to flip this to resolve a
  -- build plan, and "my X11 build silently became a Wayland build because
  -- libX11 was missing" is a bad afternoon.

library
  exposed-modules: XMonad
                   XMonad.Config
                   XMonad.Core
                   XMonad.Layout
                   XMonad.Main
                   XMonad.ManageHook
                   XMonad.Operations
                   XMonad.StackSet
  other-modules:   Paths_xmonad
  build-depends:   base                  >= 4.12 && < 5
                 , containers
                 , data-default-class
                 , directory
                 , filepath
                 , mtl
                 , process
                 , setlocale
                 , time
                 , transformers          >= 0.3
                 , unix

  -- The backend is selected by source-directory precedence, not by #ifdef.
  -- Under -f river, cabal searches src-river before src, so
  -- src-river/XMonad/Core.hs shadows src/XMonad/Core.hs.  Nothing under src/
  -- is edited to accommodate river; tests/check-x11-source.sh enforces that
  -- against the SHA in tests/upstream-base.sha.
  --
  -- The governing rule for the river backend: if something cannot be
  -- faithfully ported, it is not exported.  A name that is present but does
  -- nothing is worse than a name that is absent -- absent fails at the call
  -- site, at compile time, with the file and line in the error.  So river's
  -- API is deliberately a strict subset of the X11 one, and
  -- tests/api/unportable.txt is where each omission has to be justified, name
  -- by name, or tests/api/check-subset.sh fails.
  --
  -- The two trees are entirely separate: src-river carries its own copy of
  -- every module, and the flag-off build never looks at it.  That costs two
  -- copies of XMonad.StackSet and XMonad.Layout, which are backend-independent
  -- and could in principle be shared; the alternative was to let src-river
  -- shadow src by hs-source-dirs precedence, which makes any given module's
  -- provenance depend on a flag and on directory order.  Two honest copies
  -- read better than one file that means different things on different days,
  -- and the API goldens are what hold them in step.
  --
  -- Nothing here is named Graphics.X11.  River does not re-export it and does
  -- not imitate it; src-river/XMonad/Layout.hs imports XMonad.River.Types for
  -- the Rectangle and Event it needs.
  if flag(river)
    hs-source-dirs:  src-river
    -- The XMonad.River.* modules are exposed: they are river's own API, named
    -- for what they are, and a river-specific contrib module has every reason
    -- to import them.
    exposed-modules: XMonad.River
                     XMonad.River.Buffer
                     XMonad.River.Connection
                     XMonad.River.Keysym
                     XMonad.River.Keysym.Table
                     XMonad.River.Runtime
                     XMonad.River.Socket
                     XMonad.River.Surface
                     XMonad.River.Protocol.Core
                     XMonad.River.Protocol.LayerShell
                     XMonad.River.Protocol.WindowManagement
                     XMonad.River.Protocol.XkbBindings
                     XMonad.River.Types
                     XMonad.River.Wire
                     XMonad.River.WM
    build-depends:   bytestring
                   , network
                   , store-core
    -- The only C in the package, and only under this flag.  Wayland attaches
    -- file descriptors as SCM_RIGHTS to the same sendmsg that carries the
    -- request bytes, which network cannot express and whose CMSG_* macros are
    -- not worth reimplementing against hard-coded struct offsets.  See
    -- XMonad.River.Socket.
    c-sources:       cbits/wl-fd.c
  else
    hs-source-dirs:  src
    build-depends:   X11                   >= 1.10 && < 1.11

  ghc-options:     -funbox-strict-fields -Wall -Wno-unused-do-bind -Wincomplete-patterns -Wincomplete-uni-patterns
  if impl(ghc > 8.8.4)
    ghc-options:   -Wunused-packages
  default-language: Haskell2010

  -- Keep this in sync with the oldest version in 'tested-with'
  if impl(ghc > 8.6.5)
    ghc-options:   -Wno-unused-imports

  if flag(pedantic)
    ghc-options:   -Werror
    if impl(ghc >= 9.10)
       ghc-options: -Wno-incomplete-record-selectors

executable xmonad
  main-is:       Main.hs
  build-depends: base, xmonad
  ghc-options:   -Wall -Wno-unused-do-bind
  default-language: Haskell2010

  -- Keep this in sync with the oldest version in 'tested-with'
  if impl(ghc > 8.6.5)
    ghc-options:   -Wno-unused-imports

  if flag(pedantic)
    ghc-options:   -Werror
    if impl(ghc >= 9.10)
       ghc-options: -Wno-incomplete-record-selectors

test-suite properties
  type:           exitcode-stdio-1.0
  main-is:        Properties.hs
  other-modules:  Instances
                  Properties.Delete
                  Properties.Failure
                  Properties.Floating
                  Properties.Focus
                  Properties.GreedyView
                  Properties.Insert
                  Properties.Layout.Full
                  Properties.Layout.Tall
                  Properties.Screen
                  Properties.Shift
                  Properties.Stack
                  Properties.StackSet
                  Properties.Swap
                  Properties.View
                  Properties.Workspace
                  Utils
  hs-source-dirs: tests
  build-depends:  base
                , QuickCheck >= 2
                , quickcheck-classes >= 0.4.3
                , containers
                , xmonad
  -- This suite covers XMonad.StackSet and the layout arithmetic, both of which
  -- are shared source compiled identically by either backend, so running it
  -- under X11 covers it for river too.  It needs X11's Rectangle directly,
  -- and river deliberately does not export a Rectangle, so it is X11-only.
  if flag(river)
    buildable: False
  else
    build-depends: X11
  default-language: Haskell2010

test-suite river-fd
  type:           exitcode-stdio-1.0
  main-is:        river-fd-spec.hs
  hs-source-dirs: tests
  build-depends:  base
                , bytestring
                , network
                , unix
                , xmonad
  default-language: Haskell2010
  ghc-options:    -Wall

  -- Proves an fd can ride on the same sendmsg as the request bytes over a
  -- connected socket.  Without that there is no wl_shm_pool, so no wl_buffer,
  -- so no way for the window manager to draw at all.
  if !flag(river)
    buildable: False

test-suite river-wire
  type:           exitcode-stdio-1.0
  main-is:        river-wire-spec.hs
  hs-source-dirs: tests
  build-depends:  base
                , bytestring
                , xmonad
  default-language: Haskell2010
  ghc-options:    -Wall

  -- The wire codec, the only part of the river stack testable without a
  -- compositor.  Everything above it is unverified until run against a real
  -- river; see README.river.md.
  if !flag(river)
    buildable: False

  ghc-options:     -Wno-incomplete-patterns -Wno-incomplete-uni-patterns
  if impl(ghc > 8.8.4)
    ghc-options:   -Wno-unused-packages

  if impl(ghc > 9.8)
    ghc-options:   -Wno-x-partial

  if flag(pedantic)
    ghc-options:   -Werror
    if impl(ghc >= 9.10)
       ghc-options: -Wno-incomplete-record-selectors
